{
  "include": ["src/*.ts"],
  "exclude": ["node_modules"],
  "compilerOptions": {
    "alwaysStrict": true,
    "noImplicitAny": true,
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "inlineSourceMap": true,
    "listEmittedFiles": true,
    "outDir": "dist",
    "pretty": true,
    "skipLibCheck": true,
    "lib": ["ESNext", "dom"],
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true
  }
}
